{
  "expo": {
    "name": "Fama",
    "slug": "fama",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "fama",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-font"],
    "ios": {
      "bundleIdentifier": "app.fama.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.fama.mobile"
    }
  }
}
