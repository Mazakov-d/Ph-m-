{
  "expo": {
    "name": "Phémé",
    "slug": "pheme",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "pheme",
    "userInterfaceStyle": "automatic",
    "web": {
      "output": "single"
    },
    "plugins": ["expo-router", "expo-status-bar", "expo-font"],
    "ios": {
      "bundleIdentifier": "app.pheme.mobile",
      "supportsTablet": true
    },
    "android": {
      "package": "app.pheme.mobile"
    }
  }
}
