{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "ES2023",
    "lib": ["ES2023"],
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "removeComments": true,
    "outDir": "./dist",
    "rootDir": ".",
    "incremental": true,
    "types": ["vitest/globals", "node"]
  },
  "include": ["src", "test", "vitest.config.ts", "vitest.config.e2e.ts"]
}
