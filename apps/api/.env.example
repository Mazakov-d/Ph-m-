# Copy to .env and adjust if needed.
PORT=3000
DATABASE_URL="postgresql://fama:fama@localhost:5434/fama?schema=public"
# Separate database used by the API tests (created and migrated automatically).
TEST_DATABASE_URL="postgresql://fama:fama@localhost:5434/fama_test?schema=public"
# Secret used to sign access tokens. Use a long random value outside local development.
JWT_ACCESS_SECRET="dev-only-change-me-to-a-long-random-string"
# Web origins allowed to call the API with cookies (comma-separated).
CORS_ORIGINS="http://localhost:8081"
